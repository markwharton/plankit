{
  "system": "contacts",
  "places": [
    {
      "name": "csv",
      "outside": true,
      "invalid": "a file that is not a CSV of contacts"
    },
    {
      "name": "book",
      "belongsTo": "import",
      "keyed": true,
      "lasting": true,
      "onExisting": "replace",
      "invalid": "a contact with no email"
    },
    {
      "name": "message",
      "belongsTo": "import",
      "invalid": "a message with no text"
    }
  ],
  "elements": [
    {
      "name": "contacts",
      "steps": [
        "import"
      ]
    },
    {
      "name": "import",
      "reads": [
        {
          "place": "csv"
        },
        {
          "place": "book"
        }
      ],
      "writes": [
        {
          "place": "book",
          "mode": "create",
          "key": "content",
          "before": [
            {
              "check": "exists",
              "then": "ask"
            },
            {
              "check": "repeated",
              "then": "refuse"
            }
          ]
        },
        {
          "place": "message",
          "mode": "write"
        }
      ],
      "rejects": {
        "reason": "the file is not a CSV of contacts",
        "to": "message"
      }
    }
  ],
  "unsaid": []
}