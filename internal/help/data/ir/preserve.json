{
  "schema": 1,
  "meta": {
    "name": "preserve",
    "description": "Keep each approved plan as a record in docs/plans, on approval or on request"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "pk preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " copies an approved Claude Code plan, byte for byte, into "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " under a dated, sequenced, slugged filename and commits it with a "
        },
        {
          "type": "code",
          "text": "plan:"
        },
        {
          "type": "text",
          "text": " message."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "modes",
      "inlines": [
        {
          "type": "text",
          "text": "Modes"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The hook fires when a plan is approved (ExitPlanMode) and follows "
        },
        {
          "type": "code",
          "text": "preserve.mode"
        },
        {
          "type": "text",
          "text": " in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "auto"
              },
              {
                "type": "text",
                "text": ": preserve and commit at once"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": " (default): record the approved plan in a pending pointer and say so; nothing is committed until you ask"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": ": do nothing"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "completing-a-manual-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "Completing a manual preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Type "
        },
        {
          "type": "code",
          "text": "/plankit:preserve"
        },
        {
          "type": "text",
          "text": ", or run "
        },
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " in the repository. The explicit invocation consumes the pending pointer and commits, whatever the mode. "
        },
        {
          "type": "code",
          "text": "--push"
        },
        {
          "type": "text",
          "text": " also pushes the commit. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews the filename and commit message."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Identical plan bytes are never preserved twice; a duplicate reports the existing file. A plan shorter than "
        },
        {
          "type": "code",
          "text": "minPlanSize"
        },
        {
          "type": "text",
          "text": " bytes is ignored ("
        },
        {
          "type": "code",
          "text": "grep minPlanSize internal/preserve/preserve.go"
        },
        {
          "type": "text",
          "text": "). A typed run with nothing pending says so; the hook declines in silence, because its stdout is the response envelope."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "preserving-a-plan-revised-after-approval",
      "inlines": [
        {
          "type": "text",
          "text": "Preserving a plan revised after approval"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The approval hook reads the plan's path from "
        },
        {
          "type": "code",
          "text": "tool_response.filePath"
        },
        {
          "type": "text",
          "text": " on stdin and records it in "
        },
        {
          "type": "code",
          "text": ".git/pk-pending-plan"
        },
        {
          "type": "text",
          "text": ". A typed "
        },
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " consumes the pointer. A plan revised after it was preserved has no pointer: preserve it again with "
        },
        {
          "type": "code",
          "text": "--plan \u003cpath\u003e"
        },
        {
          "type": "text",
          "text": ", and it becomes the next sequence number for the day. The same rules apply: the path is a Claude Code plan under "
        },
        {
          "type": "code",
          "text": "~/.claude/plans/"
        },
        {
          "type": "text",
          "text": ", and identical bytes report the existing file. While the pointer names a different plan, "
        },
        {
          "type": "code",
          "text": "--plan"
        },
        {
          "type": "text",
          "text": " refuses and names both files; preserve the pending plan first."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --dry-run\n        Preview without writing or committing\n  --plan \u003cvalue\u003e\n        Plan file to preserve, for a plan revised after approval (a path under ~/.claude/plans)\n  --push\n        Push to origin after committing\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Every command also accepts "
        },
        {
          "type": "code",
          "text": "--plain"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "--project-dir \u003cvalue\u003e"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "--quiet"
        },
        {
          "type": "text",
          "text": "; see "
        },
        {
          "type": "code",
          "text": "pk help help"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "settings",
      "inlines": [
        {
          "type": "text",
          "text": "Settings"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The "
        },
        {
          "type": "code",
          "text": "preserve"
        },
        {
          "type": "text",
          "text": " section of "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\"preserve\": {\n  \"mode\": \"auto\" | \"manual\" | \"off\"\n}\n"
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "preserve.mode"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "auto"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": ", or "
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": ". An approved plan is committed at once, recorded for "
              },
              {
                "type": "code",
                "text": "/plankit:preserve"
              },
              {
                "type": "text",
                "text": " to commit, or ignored."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: "
        },
        {
          "type": "code",
          "text": "pk"
        },
        {
          "type": "text",
          "text": " commands exit 2, and each hook reports the message and takes no action until it is fixed. An absent key means its default. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads the file back and reports the first problem."
        }
      ]
    }
  ]
}
