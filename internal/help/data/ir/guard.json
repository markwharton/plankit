{
  "schema": 1,
  "meta": {
    "name": "guard",
    "description": "How pk guard decides what an agent may do to git, and how to tune it"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-guard",
      "inlines": [
        {
          "type": "text",
          "text": "pk guard"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk guard"
        },
        {
          "type": "text",
          "text": " is a PreToolUse hook on shell commands. Before the agent runs a git mutation ("
        },
        {
          "type": "code",
          "text": "commit"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "merge"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "push"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "rebase"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "reset"
        },
        {
          "type": "text",
          "text": "), guard reads "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " and answers with a permission decision. Three policies apply; the strongest decision wins, and deny beats ask."
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "branch policy ("
              },
              {
                "type": "code",
                "text": "guard.mode"
              },
              {
                "type": "text",
                "text": "): a mutation while a protected branch ("
              },
              {
                "type": "code",
                "text": "guard.branches"
              },
              {
                "type": "text",
                "text": ") is checked out is denied ("
              },
              {
                "type": "code",
                "text": "block"
              },
              {
                "type": "text",
                "text": "), questioned ("
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": "), or ignored ("
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": ")"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "push policy ("
              },
              {
                "type": "code",
                "text": "guard.push"
              },
              {
                "type": "text",
                "text": "): any "
              },
              {
                "type": "code",
                "text": "git push"
              },
              {
                "type": "text",
                "text": ", on any branch, is denied, questioned, or ignored, because pushing is the developer's action"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "breaking policy ("
              },
              {
                "type": "code",
                "text": "guard.breaking"
              },
              {
                "type": "text",
                "text": "): a commit whose message carries a breaking marker is questioned ("
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": ") or ignored ("
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": ")"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The hook recognizes git through chains ("
        },
        {
          "type": "code",
          "text": "\u0026\u0026"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": ";"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "|"
        },
        {
          "type": "text",
          "text": "), environment prefixes, absolute paths, "
        },
        {
          "type": "code",
          "text": "git -C"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "git.exe"
        },
        {
          "type": "text",
          "text": ". A compound command is judged by its parts."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "what-guard-is",
      "inlines": [
        {
          "type": "text",
          "text": "What guard is"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "A guardrail against an agent following its defaults, not a security boundary. An internal error fails open with a note on stderr. An unconfigured repository (no "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ") is a no-op."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "changing-policy",
      "inlines": [
        {
          "type": "text",
          "text": "Changing policy"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Edit "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " and commit it. The keys, their values, and their defaults are under Settings below."
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "json",
      "text": "\"guard\": {\n  \"branches\": [\"main\"],\n  \"breaking\": \"ask\",\n  \"mode\": \"block\",\n  \"push\": \"block\"\n}\n"
    },
    {
      "type": "heading",
      "level": 2,
      "id": "breaking-markers",
      "inlines": [
        {
          "type": "text",
          "text": "Breaking markers"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "A breaking marker ("
        },
        {
          "type": "code",
          "text": "!"
        },
        {
          "type": "text",
          "text": " after the type, or a "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE:"
        },
        {
          "type": "text",
          "text": " footer) drives the next major version. The marker is the developer's claim, and an agent never adds one on its own judgment. The hook asks before a "
        },
        {
          "type": "code",
          "text": "git commit"
        },
        {
          "type": "text",
          "text": " whose inline message carries a marker. "
        },
        {
          "type": "code",
          "text": "guard.breaking: \"off\""
        },
        {
          "type": "text",
          "text": " disables the ask, not the rule."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Only "
        },
        {
          "type": "code",
          "text": "-m"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "--message"
        },
        {
          "type": "text",
          "text": " arguments are inspected; "
        },
        {
          "type": "code",
          "text": "-F"
        },
        {
          "type": "text",
          "text": " files and editor commits pass through. That covers the case the rule exists for, since agent commits are "
        },
        {
          "type": "code",
          "text": "-m"
        },
        {
          "type": "text",
          "text": " commits."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "settings",
      "inlines": [
        {
          "type": "text",
          "text": "Settings"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The "
        },
        {
          "type": "code",
          "text": "guard"
        },
        {
          "type": "text",
          "text": " section of "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\"guard\": {\n  \"branches\": [\"\u003cbranch\u003e\", ...],\n  \"breaking\": \"ask\" | \"off\",\n  \"mode\": \"block\" | \"ask\" | \"off\",\n  \"push\": \"block\" | \"ask\" | \"off\"\n}\n"
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "guard.branches"
              },
              {
                "type": "text",
                "text": ": a list of branch names; default the release branch. The protected branches: a git mutation while one is checked out is judged by "
              },
              {
                "type": "code",
                "text": "guard.mode"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "guard.breaking"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": " or "
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": ". A commit whose message carries a breaking marker ("
              },
              {
                "type": "code",
                "text": "!"
              },
              {
                "type": "text",
                "text": " or "
              },
              {
                "type": "code",
                "text": "BREAKING CHANGE"
              },
              {
                "type": "text",
                "text": ") is questioned, or not."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "guard.mode"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "block"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": ", or "
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "block"
              },
              {
                "type": "text",
                "text": ". A git mutation while a protected branch is checked out is denied, questioned, or ignored."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "guard.push"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "block"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "code",
                "text": "ask"
              },
              {
                "type": "text",
                "text": ", or "
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "block"
              },
              {
                "type": "text",
                "text": ". Any "
              },
              {
                "type": "code",
                "text": "git push"
              },
              {
                "type": "text",
                "text": ", on any branch, is denied, questioned, or ignored."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: "
        },
        {
          "type": "code",
          "text": "pk"
        },
        {
          "type": "text",
          "text": " commands exit 2, and each hook reports the message and takes no action until it is fixed. An absent key means its default. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads the file back and reports the first problem."
        }
      ]
    }
  ]
}
