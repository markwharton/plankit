{
  "schema": 1,
  "meta": {
    "name": "init",
    "description": "Configure a repository for plankit"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-init",
      "inlines": [
        {
          "type": "text",
          "text": "pk init"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Configures a repository in one run:"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": ".pk.json"
              },
              {
                "type": "text",
                "text": ", the committed policy: the commit-type table (listed under "
              },
              {
                "type": "code",
                "text": "pk help changelog"
              },
              {
                "type": "text",
                "text": "), guard and preserve modes stated in full, and the release branch guarded. Its first line names the file's JSON Schema, "
              },
              {
                "type": "code",
                "text": "https://plankit.com/pk.schema.json"
              },
              {
                "type": "text",
                "text": ", generated from the same table as each page's Settings section, so an editor validates the file as it is typed."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "the plugin entries in "
              },
              {
                "type": "code",
                "text": ".claude/settings.json"
              },
              {
                "type": "text",
                "text": ": the plankit marketplace under "
              },
              {
                "type": "code",
                "text": "extraKnownMarketplaces"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": "plankit@plankit"
              },
              {
                "type": "text",
                "text": " under "
              },
              {
                "type": "code",
                "text": "enabledPlugins"
              },
              {
                "type": "text",
                "text": ", so a teammate who trusts the folder has the marketplace and is one "
              },
              {
                "type": "code",
                "text": "/plugin install"
              },
              {
                "type": "text",
                "text": " from the plugin. The file is the developer's: existing content keeps every byte, an entry already present under its key is left as it is, and a file with uncommitted changes or one that does not parse stops the run before anything is written."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "the commit "
              },
              {
                "type": "code",
                "text": "chore: configure plankit"
              },
              {
                "type": "text",
                "text": ", on the branch checked out"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "a "
              },
              {
                "type": "code",
                "text": "develop"
              },
              {
                "type": "text",
                "text": " branch, created and checked out when the release branch was the only one; a repository with another branch keeps its own"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "the release branch, created at the root commit when "
              },
              {
                "type": "code",
                "text": "--release"
              },
              {
                "type": "text",
                "text": " names one that does not exist, so it carries no unreleased work"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "the brief, printed in full"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "No tag is placed: no version tag means nothing has been released, and the first release covers the whole history. Work committed before init is in it like everything after. Init says how many commits precede its own and names the command that keeps them as history instead, "
        },
        {
          "type": "code",
          "text": "git tag v0.0.0 \u003csha\u003e"
        },
        {
          "type": "text",
          "text": " at the last of them. Nothing is pushed. The plans directory is not created here. The preserve hook creates it when the first plan is preserved, so a repository that never preserves a plan never gains the directory."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "starting-a-repository",
      "inlines": [
        {
          "type": "text",
          "text": "Starting a repository"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "git init -b main\npk init\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk init --push"
        },
        {
          "type": "text",
          "text": " publishes "
        },
        {
          "type": "code",
          "text": "main"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "develop"
        },
        {
          "type": "text",
          "text": " once "
        },
        {
          "type": "code",
          "text": "origin"
        },
        {
          "type": "text",
          "text": " exists. Set the remote's default branch to "
        },
        {
          "type": "code",
          "text": "develop"
        },
        {
          "type": "text",
          "text": " so clones start on the working branch. A repository started on "
        },
        {
          "type": "code",
          "text": "develop"
        },
        {
          "type": "text",
          "text": " instead runs "
        },
        {
          "type": "code",
          "text": "pk init --release main"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "main"
        },
        {
          "type": "text",
          "text": " is created at the root."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "procedure",
      "inlines": [
        {
          "type": "text",
          "text": "Procedure"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Run "
        },
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " in the repository, or "
        },
        {
          "type": "code",
          "text": "pk init --project-dir \u003cdir\u003e"
        },
        {
          "type": "text",
          "text": " from anywhere else, and relay its output. There is nothing left to commit. "
        },
        {
          "type": "code",
          "text": "pk init --push"
        },
        {
          "type": "text",
          "text": " also pushes both branches, when the developer asks for that."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk init\npk init --release main\npk init --branch dev\npk init --push\npk init --dry-run\npk init --format json\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "--release"
        },
        {
          "type": "text",
          "text": " names the branch to guard and release into; the default is the branch checked out. When origin's default branch is another, init refuses rather than guard a working branch, and names both. A named branch that does not exist is created at the root commit. "
        },
        {
          "type": "code",
          "text": "--branch"
        },
        {
          "type": "text",
          "text": " names the working branch to create; the default is "
        },
        {
          "type": "code",
          "text": "develop"
        },
        {
          "type": "text",
          "text": ". "
        },
        {
          "type": "code",
          "text": "--no-commit"
        },
        {
          "type": "text",
          "text": " writes the files and stops, to read them first; guard blocks a session from committing them on the release branch, so the developer commits and branches by hand. "
        },
        {
          "type": "code",
          "text": "--push"
        },
        {
          "type": "text",
          "text": " pushes the release branch and the working branch to "
        },
        {
          "type": "code",
          "text": "origin"
        },
        {
          "type": "text",
          "text": ", and refuses to start without one. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews every step without writing. "
        },
        {
          "type": "code",
          "text": "--format json"
        },
        {
          "type": "text",
          "text": " emits one object: "
        },
        {
          "type": "code",
          "text": "root"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "release"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "created"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "committed"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "branch"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "pushed"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "dryRun"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " refuses to run twice; edit "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " once it exists. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads it back and reports the first problem, and notes a missing branch or plugin entry."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "In a repository still carrying the files a v0.x "
        },
        {
          "type": "code",
          "text": "pk setup"
        },
        {
          "type": "text",
          "text": " copied in, the refusal says so and points at "
        },
        {
          "type": "code",
          "text": "pk help overview"
        },
        {
          "type": "text",
          "text": ": those files wire the hooks the plugin already ships, so each one fires twice."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --branch \u003cvalue\u003e\n        Working branch to create when the release branch is the only one (default develop)\n  --dry-run\n        Preview without making any changes\n  --format \u003cvalue\u003e\n        Output format: text or json (default text)\n  --no-commit\n        Leave .pk.json and .claude/settings.json uncommitted\n  --push\n        Push the release branch, the tag, and the working branch to origin\n  --release \u003cvalue\u003e\n        Release branch to guard (default: the branch currently checked out)\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Every command also accepts "
        },
        {
          "type": "code",
          "text": "--plain"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "--project-dir \u003cvalue\u003e"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "--quiet"
        },
        {
          "type": "text",
          "text": "; see "
        },
        {
          "type": "code",
          "text": "pk help help"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    }
  ]
}
