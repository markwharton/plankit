        "source": { "file": "internal/release/release.go", "function": "run" } }
    },
    { "name": "switch back",
      "source": { "file": "internal/release/release.go", "function": "switchBack" },
      "reads": [
        { "place": "working branch",
          "source": { "file": "internal/release/release.go", "function": "switchBack" } }
      ],
      "writes": [
        { "place": "working tree", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "switchBack" } },
        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "switchBack" } }
      ]
    },
    { "name": "push working branch",
      "source": { "file": "internal/release/release.go", "function": "run" },
      "reads": [
        { "place": "working branch",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "writes": [
        { "place": "origin", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ]
    }
  ],
  "unsaid": [
    { "what": "a failure after tagging rolls back: the local tag is deleted, the merge is reset, and the working branch is checked out",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "a failure after the switch to the release branch and before tagging rolls back the same way, with no tag to delete; the merge is reset by git reset --hard to the commit the release branch was at before the merge",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "a rollback step that fails prints a warning, the other rollback steps still run, and the error returned is the one that stopped release",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "a release ends on the working branch, with the tag, the release branch and the working branch all on origin",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "the release branch and the tag are pushed together",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "the push of the release branch and the tag uses git push --atomic and no force; the working branch goes in a second, separate push after the switch back",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "once the release branch and the tag are on origin the release stands: a failure to switch back or to push the working branch is a warning",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "after a failed switch back or a failed push of the working branch, release still prints that it is complete and returns no error",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "preRelease runs before the tag exists, and prePush runs with the tag in existence",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "the check that no local tag of the trailer's name exists is made at the start, before the working tree check, the fetches, the merge and the preRelease hook; nothing checks again at the moment of tagging except git itself",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "a preRelease hook that commits produces a commit the tag then covers",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "the tag is put on whatever commit is at HEAD when tagging happens",
      "source": { "file": "internal/git/git.go", "function": "CreateTag" } },
    { "what": "a hook is a command line from settings run through the shell in the repository's root, with VERSION (the tag without its v) and TAG set in its environment and replaced in the command text; what the command changes is not known to release; a hook that is not set runs nothing",
      "source": { "file": "internal/hookio/hookio.go", "function": "RunScript" } },
    { "what": "release with --dry-run merges nothing, tags nothing and pushes nothing",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "with --dry-run, release still makes the pre-flight checks and their fetches, in merge flow checks that the local release branch, when there is one, is an ancestor of the working branch and prints that it would merge, runs the preRelease hook for real on the working branch's checkout, and prints what it would tag and push; it does not run the prePush hook",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "a release dry run rehearses the merge against origin's release branch when there is no local one",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "in trunk flow, when release.branch is not set, there is no merge and no switching: the tag goes on the working branch's HEAD, and one atomic push sends the working branch and the tag, with no second push",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "trunk flow refuses a working branch that is not origin's default branch only when origin names its default branch; when origin names none, or cannot be asked for it, the check is skipped and the release goes ahead on the working branch",
      "source": { "file": "internal/changelog/preflight.go", "function": "CheckTrunkBranch" } },
    { "what": "a refusal for a condition the person can fix is returned as a state error, some with a hint naming the fix; a failure of git in switch, rev-parse, merge-base, tag --list or tag is returned as a plain error, which the caller reports with a different exit code",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "what": "everything release prints, the hooks' output included, goes to standard error; it writes nothing to standard output",
      "source": { "file": "internal/release/release.go", "function": "run" } }
  ]
}
