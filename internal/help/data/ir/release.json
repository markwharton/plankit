{
  "schema": 1,
  "meta": {
    "name": "release",
    "description": "Tag the pending release from the Release-Tag trailer and push it, with pre-flight checks and rollback"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-release",
      "inlines": [
        {
          "type": "text",
          "text": "pk release"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Completes what "
        },
        {
          "type": "code",
          "text": "pk changelog"
        },
        {
          "type": "text",
          "text": " staged: reads the "
        },
        {
          "type": "code",
          "text": "Release-Tag"
        },
        {
          "type": "text",
          "text": " trailer on HEAD, runs pre-flight checks, creates the tag, and pushes atomically to origin."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "two-flows",
      "inlines": [
        {
          "type": "text",
          "text": "Two flows"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "With "
        },
        {
          "type": "code",
          "text": "release.branch"
        },
        {
          "type": "text",
          "text": " configured, the merge flow: fast-forward the release branch to the working branch, tag, push branch and tag together, switch back, push the working branch. Without it, the trunk flow: tag and push the default branch, and refuse to run anywhere else."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "pre-flight",
      "inlines": [
        {
          "type": "text",
          "text": "Pre-flight"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Clean tree; branch on origin and not behind it; release branch resolvable and not diverged from the working branch. A failure after tagging rolls back: the local tag is deleted, the merge is reset, and the working branch is checked out."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "hooks",
      "inlines": [
        {
          "type": "text",
          "text": "Hooks"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "preRelease"
        },
        {
          "type": "text",
          "text": " runs before the tag exists and is rehearsed by "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": ". A "
        },
        {
          "type": "code",
          "text": "preRelease"
        },
        {
          "type": "text",
          "text": " hook that commits produces a commit the tag then covers. "
        },
        {
          "type": "code",
          "text": "prePush"
        },
        {
          "type": "text",
          "text": " runs with the tag ref in existence, for signing or artifact builds keyed on the tag. Both receive "
        },
        {
          "type": "code",
          "text": "$VERSION"
        },
        {
          "type": "text",
          "text": " (no v) and "
        },
        {
          "type": "code",
          "text": "$TAG"
        },
        {
          "type": "text",
          "text": " (with it)."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk release --dry-run\npk release\n"
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --dry-run\n        Validate without merging, tagging, or pushing\n"
    },
    {
      "type": "heading",
      "level": 2,
      "id": "settings",
      "inlines": [
        {
          "type": "text",
          "text": "Settings"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The "
        },
        {
          "type": "code",
          "text": "release"
        },
        {
          "type": "text",
          "text": " section of "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\"release\": {\n  \"branch\": \"\u003cbranch\u003e\",\n  \"hooks\": {\n    \"prePush\": \"\u003ccommand\u003e\",\n    \"preRelease\": \"\u003ccommand\u003e\"\n  }\n}\n"
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "release.branch"
              },
              {
                "type": "text",
                "text": ": a branch name; default the branch "
              },
              {
                "type": "code",
                "text": "pk init"
              },
              {
                "type": "text",
                "text": " ran on. The branch releases merge into; empty selects the trunk flow, which tags the default branch."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "release.hooks.prePush"
              },
              {
                "type": "text",
                "text": ": a shell command; default none. Runs after the tag exists and before the push, with "
              },
              {
                "type": "code",
                "text": "$VERSION"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": "$TAG"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "release.hooks.preRelease"
              },
              {
                "type": "text",
                "text": ": a shell command; default none. Runs before the tag is created, with "
              },
              {
                "type": "code",
                "text": "$VERSION"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": "$TAG"
              },
              {
                "type": "text",
                "text": "; "
              },
              {
                "type": "code",
                "text": "--dry-run"
              },
              {
                "type": "text",
                "text": " rehearses it."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: "
        },
        {
          "type": "code",
          "text": "pk"
        },
        {
          "type": "text",
          "text": " commands exit 2, and each hook reports the message and takes no action until it is fixed. An absent key means its default. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads the file back and reports the first problem."
        }
      ]
    }
  ]
}
