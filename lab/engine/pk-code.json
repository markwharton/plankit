{
  "system": "pk: changelog, release and ship",
  "on": [
    "git.json"
  ],
  "reports": "message",
  "places": [
    {
      "name": "settings",
      "is": "one",
      "kind": "outside"
    },
    {
      "name": "origin address",
      "is": "one",
      "kind": "outside"
    },
    {
      "name": "working branch",
      "is": "series",
      "kind": "lasting"
    },
    {
      "name": "release branch",
      "is": "series",
      "kind": "lasting"
    },
    {
      "name": "origin's working branch",
      "is": "series",
      "kind": "lasting",
      "in": "origin"
    },
    {
      "name": "origin's release branch",
      "is": "series",
      "kind": "lasting",
      "in": "origin"
    },
    {
      "name": "changelog file",
      "is": "one",
      "kind": "lasting",
      "in": "working tree"
    },
    {
      "name": "version files",
      "is": "one",
      "kind": "lasting",
      "in": "working tree"
    },
    {
      "name": "next version",
      "is": "one",
      "kind": "run"
    },
    {
      "name": "commits since tag",
      "is": "one",
      "kind": "run"
    },
    {
      "name": "section",
      "is": "one",
      "kind": "run"
    },
    {
      "name": "message",
      "is": "one",
      "kind": "report"
    },
    {
      "name": "standard output",
      "is": "one",
      "kind": "report"
    }
  ],
  "facts": [
    {
      "name": "dry run",
      "says": "--dry-run is given"
    },
    {
      "name": "undo",
      "says": "--undo is given",
      "only": {
        "not": "in ship"
      }
    },
    {
      "name": "nothing to release",
      "says": "no commit since the last version tag is one the changelog lists"
    },
    {
      "name": "no local version tag",
      "says": "the repository has no version tag"
    },
    {
      "name": "trunk flow",
      "says": "release.branch is empty"
    },
    {
      "name": "the last commit is a release commit",
      "about": "working branch",
      "says": "HEAD carries a Release-Tag trailer"
    },
    {
      "name": "settings are invalid",
      "fault": true,
      "about": "settings"
    },
    {
      "name": "no branch is checked out",
      "fault": true,
      "about": "working branch",
      "says": "HEAD is detached"
    },
    {
      "name": "the working branch is protected",
      "fault": true,
      "about": "working branch",
      "says": "the branch is one guard.branches lists"
    },
    {
      "name": "the working branch is not on origin",
      "fault": true,
      "about": "working branch"
    },
    {
      "name": "the working branch is behind origin",
      "fault": true,
      "about": "working branch",
      "says": "origin's tip of the branch, read without a fetch, is not in the branch's history"
    },
    {
      "name": "origin names no default branch",
      "only": "trunk flow",
      "says": "origin advertises no HEAD, so the default-branch check cannot run"
    },
    {
      "name": "the branch is not the default",
      "fault": true,
      "about": "working branch",
      "only": {
        "all": [
          "trunk flow",
          {
            "not": "origin names no default branch"
          }
        ]
      }
    },
    {
      "name": "a tag does not name a version",
      "about": "tags",
      "says": "the repository has a tag whose name is not a version"
    },
    {
      "name": "the changelog file cannot be read",
      "fault": true,
      "about": "changelog file"
    },
    {
      "name": "a version file has no version field",
      "fault": true,
      "about": "version files"
    },
    {
      "name": "origin has no address",
      "fault": true,
      "about": "origin address"
    },
    {
      "name": "the last version tag is not in the branch's history",
      "fault": true
    },
    {
      "name": "the postVersion command fails",
      "fault": true
    },
    {
      "name": "the preCommit command fails",
      "fault": true
    },
    {
      "name": "the preRelease command fails",
      "fault": true
    },
    {
      "name": "the prePush command fails",
      "fault": true
    },
    {
      "name": "the --bump value is not a level",
      "fault": true
    },
    {
      "name": "an --exclude entry matches no commit",
      "fault": true
    }
  ],
  "parts": {
    "changelog": {
      "name": "changelog",
      "seq": [
        "load settings",
        {
          "choose": [
            {
              "when": "undo",
              "run": "undo"
            }
          ],
          "otherwise": "make changelog"
        }
      ]
    },
    "undo": {
      "do": "undo",
      "uses": "reset to the commit before",
      "with": {
        "the branch": "working branch"
      },
      "rehearsal": "dry run",
      "makes": {
        "the last commit is a release commit": false
      },
      "handles": [
        {
          "when": "working branch is held elsewhere",
          "then": "refuse",
          "says": "--undo refuses a commit that is pushed, tagged or merged",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestUndoRefusesACommitSomethingElseHolds"
          }
        },
        {
          "when": "working tree holds what is kept nowhere",
          "then": "refuse"
        },
        {
          "when": {
            "not": "the last commit is a release commit"
          },
          "then": "refuse"
        },
        {
          "when": {
            "any": [
              "the branch is not the default",
              "no branch is checked out",
              "the working branch is protected",
              "the working branch is not on origin",
              "the working branch is behind origin"
            ]
          },
          "then": "accept",
          "because": "undo removes only a commit that nothing else holds, so the branch it is on does not matter"
        }
      ],
      "says": "--undo unwinds the release commit and restores the changelog file and the version files"
    },
    "make changelog": {
      "name": "make changelog",
      "seq": [
        "branch checks",
        {
          "use": "fetch the tags",
          "when": "no local version tag"
        },
        "infer version",
        "pending release check",
        {
          "choose": [
            {
              "when": "nothing to release",
              "run": "say nothing to release"
            }
          ],
          "otherwise": {
            "seq": [
              "build section",
              {
                "choose": [
                  {
                    "when": "dry run",
                    "run": "print section"
                  }
                ],
                "otherwise": "write release"
              }
            ]
          }
        }
      ]
    },
    "branch checks": {
      "do": "branch checks",
      "reads": [
        "settings",
        "working tree",
        "working branch",
        "origin"
      ],
      "handles": [
        {
          "when": "the working branch is behind origin",
          "then": "accept",
          "because": "changelog makes no check for it; release refuses it before tagging"
        },
        {
          "when": {
            "all": [
              {
                "not": "dry run"
              },
              {
                "any": [
                  "working tree holds what is kept nowhere",
                  "no branch is checked out"
                ]
              }
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestRefusals"
          }
        },
        {
          "when": {
            "any": [
              "the working branch is protected",
              "the working branch is not on origin",
              "origin does not answer"
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestRefusals"
          }
        },
        {
          "when": "the branch is not the default",
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestTrunkFlowRefusesNonDefaultBranch"
          }
        },
        {
          "when": {
            "any": [
              "working tree holds what is kept nowhere",
              "no branch is checked out"
            ]
          },
          "then": "accept",
          "because": "a dry run writes nothing, so it may read the commits from anywhere"
        },
        {
          "when": "origin names no default branch",
          "then": "accept",
          "because": "the check cannot run, and changelog goes on without saying so"
        }
      ]
    },
    "fetch the tags": {
      "do": "fetch the tags",
      "uses": "fetch tags",
      "handles": [
        {
          "when": "origin does not answer",
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestNoLocalTagsButOriginHasThem"
          }
        },
        {
          "when": "tags already has the member",
          "then": "fail"
        },
        {
          "when": "tags is given a key twice",
          "then": "accept",
          "because": "git's reason stands: a remote holds one tag of each name."
        }
      ],
      "says": "with no local tags, changelog fetches origin's tags first and measures from the latest",
      "later": "stands",
      "because": "the tags fetched are origin's, and a later run would fetch them again"
    },
    "infer version": {
      "do": "infer version",
      "reads": [
        "tags",
        "working branch"
      ],
      "changes": [
        {
          "place": "commits since tag",
          "how": "create"
        },
        {
          "place": "next version",
          "how": "create"
        }
      ],
      "handles": [
        {
          "when": "the last version tag is not in the branch's history",
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestTagOutsideHistoryIsRefused"
          }
        },
        {
          "when": "the --bump value is not a level",
          "then": "refuse"
        },
        {
          "when": "an --exclude entry matches no commit",
          "then": "tell"
        }
      ]
    },
    "pending release check": {
      "do": "pending release check",
      "when": {
        "not": "dry run"
      },
      "reads": [
        "working branch"
      ],
      "handles": [
        {
          "when": "the last commit is a release commit",
          "then": "refuse"
        }
      ]
    },
    "say nothing to release": {
      "do": "say nothing to release",
      "changes": [
        {
          "place": "message",
          "how": "create"
        }
      ]
    },
    "build section": {
      "do": "build section",
      "reads": [
        "settings",
        "commits since tag",
        "next version"
      ],
      "changes": [
        {
          "place": "section",
          "how": "create"
        }
      ]
    },
    "print section": {
      "do": "print section",
      "reads": [
        "section"
      ],
      "changes": [
        {
          "place": "standard output",
          "how": "create"
        }
      ]
    },
    "write release": {
      "name": "write release",
      "seq": [
        "stamp versions",
        "postVersion hook",
        "write section",
        "preCommit hook",
        "commit the release"
      ]
    },
    "stamp versions": {
      "do": "stamp versions",
      "reads": [
        "settings",
        "next version",
        "version files"
      ],
      "changes": [
        {
          "place": "version files",
          "how": "replace",
          "later": "undone",
          "says": "when a version file or a hook fails, nothing is committed and the tree goes back to how the run found it",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestARefusedReleasePutsTheWholeTreeBack"
          }
        }
      ],
      "handles": [
        {
          "when": "a version file has no version field",
          "then": "refuse"
        }
      ]
    },
    "postVersion hook": {
      "do": "postVersion hook",
      "reads": [
        "settings",
        "next version"
      ],
      "handles": [
        {
          "when": "the postVersion command fails",
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestFailingHookAborts"
          }
        }
      ]
    },
    "write section": {
      "do": "write section",
      "reads": [
        "section",
        "changelog file",
        "commits since tag",
        "next version",
        "origin address"
      ],
      "changes": [
        {
          "place": "changelog file",
          "how": "replace",
          "later": "undone"
        }
      ],
      "handles": [
        {
          "when": "the changelog file cannot be read",
          "then": "refuse",
          "hold": {
            "file": "internal/changelog/changelog_test.go",
            "test": "TestAChangelogThatIsThereMustBeReadable"
          }
        },
        {
          "when": "origin has no address",
          "then": "accept",
          "because": "the section is then written with no link"
        }
      ]
    },
    "preCommit hook": {
      "do": "preCommit hook",
      "reads": [
        "settings",
        "next version"
      ],
      "handles": [
        {
          "when": "the preCommit command fails",
          "then": "refuse"
        }
      ]
    },
    "commit the release": {
      "do": "commit the release",
      "uses": "commit",
      "with": {
        "the branch": "working branch"
      },
      "makes": {
        "the last commit is a release commit": true
      },
      "later": "undone",
      "says": "pk ship runs changelog and then release, and when the release half fails it undoes the changelog commit it made",
      "handles": [
        {
          "when": "the commit cannot be made",
          "then": "refuse"
        }
      ],
      "hold": {
        "file": "internal/ship/ship_test.go",
        "test": "TestFailedReleaseUndoesTheChangelogCommit"
      }
    },
    "release": {
      "name": "release",
      "seq": [
        "load settings",
        "fetch the working branch",
        "pre-flight",
        {
          "use": "merge",
          "when": {
            "not": "trunk flow"
          }
        },
        "preRelease hook",
        {
          "use": "tag the release",
          "when": {
            "not": "dry run"
          }
        },
        {
          "use": "prePush hook",
          "when": {
            "not": "dry run"
          }
        },
        {
          "choose": [
            {
              "when": "trunk flow",
              "run": "push in trunk flow"
            }
          ],
          "otherwise": "push in merge flow",
          "when": {
            "not": "dry run"
          }
        },
        {
          "use": "switch back",
          "when": {
            "all": [
              {
                "not": "dry run"
              },
              {
                "not": "trunk flow"
              }
            ]
          }
        },
        {
          "use": "push the working branch",
          "when": {
            "all": [
              {
                "not": "dry run"
              },
              {
                "not": "trunk flow"
              }
            ]
          }
        }
      ],
      "says": "in trunk flow there is no merge: the release tags and pushes the default branch"
    },
    "fetch the working branch": {
      "do": "fetch the working branch",
      "uses": "fetch the branch",
      "with": {
        "origin's branch": "origin's working branch"
      },
      "handles": [
        {
          "when": "origin does not answer",
          "then": "refuse"
        },
        {
          "when": "remote-tracking branch holds what is kept nowhere",
          "then": "accept",
          "because": "pre-flight fetches, which brings it up to date"
        }
      ],
      "later": "stands",
      "because": "a remote-tracking branch is a copy of origin's branch, and the next fetch makes it again"
    },
    "pre-flight": {
      "do": "pre-flight",
      "reads": [
        "working branch",
        "settings",
        "working tree",
        {
          "place": "release branch",
          "when": {
            "not": "trunk flow"
          }
        },
        "tags",
        "remote-tracking branch"
      ],
      "handles": [
        {
          "when": {
            "any": [
              {
                "not": "the last commit is a release commit"
              },
              "working tree holds what is kept nowhere",
              "no branch is checked out",
              "the working branch is protected",
              "the working branch is not on origin",
              "the working branch is behind origin",
              "the last version tag is not in the branch's history",
              {
                "all": [
                  {
                    "not": "trunk flow"
                  },
                  "the branch cannot be fast-forwarded"
                ]
              }
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestRefusals"
          }
        },
        {
          "when": {
            "all": [
              "the branch is not the default",
              {
                "not": "origin names no default branch"
              }
            ]
          },
          "then": "refuse",
          "says": "trunk flow refuses to run on any branch but the default branch",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestTrunkFlowRefusesNonDefaultBranch"
          }
        },
        {
          "when": "origin names no default branch",
          "then": "tell",
          "says": "the run says the default-branch check could not run, and goes on"
        }
      ]
    },
    "merge": {
      "name": "merge",
      "seq": [
        {
          "do": "switch to the release branch",
          "uses": "switch",
          "with": {
            "the branch": "release branch"
          },
          "rehearsal": "dry run",
          "later": "undone",
          "handles": [
            {
              "when": "the switch fails",
              "then": "refuse"
            }
          ],
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestRejectedPushRollsEverythingBack"
          }
        },
        {
          "do": "fast-forward the release branch",
          "uses": "fast-forward",
          "with": {
            "the branch": "release branch",
            "the other branch": "working branch"
          },
          "rehearsal": "dry run",
          "later": "undone",
          "handles": [
            {
              "when": "the branch cannot be fast-forwarded",
              "then": "refuse",
              "hold": {
                "file": "internal/release/release_test.go",
                "test": "TestDivergedReleaseBranchRefused"
              }
            }
          ]
        }
      ],
      "says": [
        "a release dry run rehearses the merge against origin's release branch when there is no local one",
        "a failure after tagging rolls back: the local tag is deleted, the merge is reset, and the working branch is checked out"
      ]
    },
    "preRelease hook": {
      "do": "preRelease hook",
      "reads": [
        "settings",
        "working branch"
      ],
      "handles": [
        {
          "when": "the preRelease command fails",
          "then": "refuse"
        }
      ]
    },
    "tag the release": {
      "do": "tag the release",
      "uses": "tag",
      "with": {
        "the branch": "working branch"
      },
      "later": "undone",
      "handles": [
        {
          "when": {
            "any": [
              "tags already has the member",
              "the tag cannot be created"
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestRefusals"
          }
        }
      ]
    },
    "prePush hook": {
      "do": "prePush hook",
      "reads": [
        "settings",
        "working branch"
      ],
      "handles": [
        {
          "when": "the prePush command fails",
          "then": "refuse",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestFailingPrePushCleansUp"
          }
        }
      ]
    },
    "push in trunk flow": {
      "do": "push in trunk flow",
      "uses": "push the branch and the tag",
      "with": {
        "the branch": "working branch",
        "origin's branch": "origin's working branch"
      },
      "later": "stands",
      "because": "once the branch and the tag are on origin the release stands",
      "handles": [
        {
          "when": {
            "any": [
              "origin does not answer",
              "origin rejects the push"
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestRejectedPushRollsEverythingBack"
          }
        }
      ]
    },
    "push in merge flow": {
      "do": "push in merge flow",
      "uses": "push the branch and the tag",
      "with": {
        "the branch": "release branch",
        "origin's branch": "origin's release branch"
      },
      "later": "stands",
      "because": "once the release branch and the tag are on origin the release stands",
      "handles": [
        {
          "when": {
            "any": [
              "origin does not answer",
              "origin rejects the push"
            ]
          },
          "then": "refuse",
          "hold": {
            "file": "internal/release/release_test.go",
            "test": "TestRejectedPushRollsEverythingBack"
          }
        }
      ],
      "says": "the release branch and the tag are pushed together"
    },
    "switch back": {
      "do": "switch back",
      "uses": "switch",
      "with": {
        "the branch": "working branch"
      },
      "handles": [
        {
          "when": "the switch fails",
          "then": "warn",
          "says": "once the release branch and the tag are on origin the release stands: a failure to switch back or to push the working branch is a warning"
        }
      ]
    },
    "push the working branch": {
      "do": "push the working branch",
      "uses": "push the branch",
      "with": {
        "the branch": "working branch",
        "origin's branch": "origin's working branch"
      },
      "handles": [
        {
          "when": {
            "any": [
              "origin does not answer",
              "origin rejects the push"
            ]
          },
          "then": "warn"
        }
      ]
    },
    "ship": {
      "name": "ship",
      "seq": [
        "changelog",
        "release"
      ]
    },
    "load settings": {
      "do": "load settings",
      "reads": [
        "settings"
      ],
      "handles": [
        {
          "when": "settings are invalid",
          "then": "refuse",
          "says": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: pk commands exit 2"
        }
      ]
    }
  },
  "runs": [
    "changelog",
    "release",
    "ship"
  ],
  "expects": [
    {
      "name": "changelog with --dry-run writes nothing",
      "in": "changelog",
      "when": "dry run",
      "never changes": [
        "working tree",
        "tags",
        "origin",
        "remote-tracking branch",
        "release branch",
        "working branch"
      ],
      "says": "changelog with --dry-run prints the section to standard output and writes nothing",
      "hold": {
        "file": "internal/changelog/changelog_test.go",
        "test": "TestDryRunPrintsSectionToStdout"
      }
    },
    {
      "name": "--undo with --dry-run changes nothing",
      "in": "changelog",
      "when": {
        "all": [
          "undo",
          "dry run"
        ]
      },
      "never changes": [
        "working tree",
        "tags",
        "origin",
        "remote-tracking branch",
        "release branch",
        "working branch"
      ],
      "says": "--undo with --dry-run makes the same checks and changes nothing",
      "hold": {
        "file": "internal/changelog/changelog_test.go",
