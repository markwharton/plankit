      "writes": [
        { "place": "origin", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "rejects": {
        "reason": "git push of the release branch and the tag fails: origin refuses either one or does not answer",
