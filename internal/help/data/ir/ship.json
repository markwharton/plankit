{
  "schema": 1,
  "meta": {
    "name": "ship",
    "description": "Cut the pending work as one release - changelog then release in a single command"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-ship",
      "inlines": [
        {
          "type": "text",
          "text": "pk ship"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Runs "
        },
        {
          "type": "code",
          "text": "pk changelog"
        },
        {
          "type": "text",
          "text": " then "
        },
        {
          "type": "code",
          "text": "pk release"
        },
        {
          "type": "text",
          "text": " as one invocation. "
        },
        {
          "type": "code",
          "text": "pk ship"
        },
        {
          "type": "text",
          "text": " carries no state of its own: what remains is the "
        },
        {
          "type": "code",
          "text": "Release-Tag"
        },
        {
          "type": "text",
          "text": " trailer on HEAD and whether its tag exists. A run interrupted between the halves resumes at release on rerun."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk ship --dry-run\npk ship\npk ship --bump patch\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "--bump"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "--exclude"
        },
        {
          "type": "text",
          "text": " pass through to changelog. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews the section when nothing is pending, or rehearses the release when a Release-Tag commit exists; the release half cannot be rehearsed before its changelog commit exists."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "If the release half fails, the changelog commit stands. Rerun "
        },
        {
          "type": "code",
          "text": "pk ship"
        },
        {
          "type": "text",
          "text": " to retry, or "
        },
        {
          "type": "code",
          "text": "pk changelog --undo"
        },
        {
          "type": "text",
          "text": " to unwind."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "releasing",
      "inlines": [
        {
          "type": "text",
          "text": "Releasing"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Releasing is the developer's call. Run "
        },
        {
          "type": "code",
          "text": "pk ship"
        },
        {
          "type": "text",
          "text": " when the developer asks for a release, not on your own reading of a preview. When the inferred bump is a major, show the commits carrying "
        },
        {
          "type": "code",
          "text": "!"
        },
        {
          "type": "text",
          "text": " or "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE"
        },
        {
          "type": "text",
          "text": " and the section, and wait for the developer's go."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "permissions",
      "inlines": [
        {
          "type": "text",
          "text": "Permissions"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk ship"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "pk release"
        },
        {
          "type": "text",
          "text": " publish: they tag and push. Where a session allowlists pk commands, allowlist the ones that only read or stage ("
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "pk changelog"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "pk ship --dry-run"
        },
        {
          "type": "text",
          "text": ") and leave "
        },
        {
          "type": "code",
          "text": "pk ship"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "pk release"
        },
        {
          "type": "text",
          "text": " off, so a release still needs the developer's approval."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --bump \u003cvalue\u003e\n        Override the version bump: major, minor, or patch (passed to changelog)\n  --dry-run\n        Rehearse: preview the section, or the release when one is already pending\n  --exclude \u003cvalue\u003e\n        Comma-separated commit SHAs to drop from the section (passed to changelog)\n"
    }
  ]
}
