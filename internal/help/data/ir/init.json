{
  "schema": 1,
  "meta": {
    "name": "init",
    "description": "Configure a repository for plankit - write .pk.json and baseline a tag"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-init",
      "inlines": [
        {
          "type": "text",
          "text": "pk init"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Configures the current repository. One run creates:"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": ".pk.json"
              },
              {
                "type": "text",
                "text": ", the committed policy: the commit-type table (listed under "
              },
              {
                "type": "code",
                "text": "pk help changelog"
              },
              {
                "type": "text",
                "text": "), guard and preserve modes stated in full, and the release branch guarded. Its first line names the file's JSON Schema, "
              },
              {
                "type": "code",
                "text": "https://plankit.com/pk.schema.json"
              },
              {
                "type": "text",
                "text": ", generated from the same table as each page's Settings section, so an editor validates the file as it is typed."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "a "
              },
              {
                "type": "code",
                "text": "v0.0.0"
              },
              {
                "type": "text",
                "text": " baseline tag when the repository has commits but no tag"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " is not created here. The preserve hook creates it when the first plan is preserved, so a repository that never preserves a plan never gains the directory."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk init\npk init --release trunk\npk init --dry-run\npk init --format json\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "--release"
        },
        {
          "type": "text",
          "text": " names the branch to guard and release from; the default is the branch checked out. "
        },
        {
          "type": "code",
          "text": "--no-baseline"
        },
        {
          "type": "text",
          "text": " skips the tag. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews without writing. "
        },
        {
          "type": "code",
          "text": "--format json"
        },
        {
          "type": "text",
          "text": " emits one object: "
        },
        {
          "type": "code",
          "text": "root"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "release"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "created"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "code",
          "text": "baseline"
        },
        {
          "type": "text",
          "text": ", and "
        },
        {
          "type": "code",
          "text": "dryRun"
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " refuses to run twice; edit "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " once it exists, and "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads it back and reports the first problem. Commit the created files."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --release \u003cvalue\u003e\n        Release branch to guard (default: the branch currently checked out)\n  --no-baseline\n        Skip creating the v0.0.0 baseline tag\n  --dry-run\n        Preview without making any changes\n  --format \u003cvalue\u003e\n        Output format: text or json (default text)\n"
    }
  ]
}
