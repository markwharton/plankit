    { "name": "working tree",
      "source": { "file": "internal/git/git.go", "function": "CheckCleanTree" } },
    { "name": "working branch",
      "source": { "file": "internal/git/git.go", "function": "CurrentBranch" } },
    { "name": "release branch",
      "source": { "file": "internal/release/release.go", "function": "run" } },
    { "name": "tags", "keyed": true, "onExisting": "refuse",
