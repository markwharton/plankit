{
  "schema": 1,
  "meta": {
    "name": "brief",
    "description": "What each session is told about this repository's plankit policy at start, generated from .pk.json"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-brief",
      "inlines": [
        {
          "type": "text",
          "text": "pk brief"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The repository's policy, rendered as instructions for a session. The SessionStart hook runs it on every start, resume, and compaction and injects the text as context. Nothing is copied into the repository: the text is derived from "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " on each run."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk brief\npk brief --format json\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "At a terminal, "
        },
        {
          "type": "code",
          "text": "pk brief"
        },
        {
          "type": "text",
          "text": " prints the text a session receives. "
        },
        {
          "type": "code",
          "text": "--format json"
        },
        {
          "type": "text",
          "text": " prints the SessionStart envelope the hook emits. In an unconfigured repository the hook is silent and the command says so."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "what-it-says",
      "inlines": [
        {
          "type": "text",
          "text": "What it says"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The first and last sentences are constant. The rest follows the dials. "
        },
        {
          "type": "code",
          "text": "changelog.types"
        },
        {
          "type": "text",
          "text": " lists the commit types, the default table when the file leaves it empty. "
        },
        {
          "type": "code",
          "text": "guard.breaking"
        },
        {
          "type": "text",
          "text": " decides whether the marker rule mentions the ask. "
        },
        {
          "type": "code",
          "text": "guard.mode"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "guard.push"
        },
        {
          "type": "text",
          "text": " describe the protected branches and pushing. "
        },
        {
          "type": "code",
          "text": "release.branch"
        },
        {
          "type": "text",
          "text": " names where releases merge. "
        },
        {
          "type": "code",
          "text": "preserve.mode"
        },
        {
          "type": "text",
          "text": " describes how plans are kept. A dial set to off drops its paragraph."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --format \u003cvalue\u003e\n        Output format: text or json (default text)\n"
    }
  ]
}
