{
  "schema": 1,
  "meta": {
    "name": "plankit",
    "description": "Plan-driven development for Claude Code - the model, the modes, and the per-repo footprint"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "plankit",
      "inlines": [
        {
          "type": "text",
          "text": "plankit"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "plankit preserves approved Claude Code plans and protects the flow they describe. It ships as a Claude Code plugin: these skills are the documentation, the hooks call the pk binary, and "
        },
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " renders the same pages in the terminal."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "model",
      "inlines": [
        {
          "type": "text",
          "text": "Model"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Claude plans the work. On approval, the preserve hook copies the plan, byte for byte, into "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " under a dated, sequenced filename. The protect hook keeps that directory immutable, and the guard hook blocks git mutations on protected branches, so work lands through the planned flow."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "per-repo-footprint",
      "inlines": [
        {
          "type": "text",
          "text": "Per-repo footprint"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "A configured repository carries exactly two things:"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": ".pk.json"
              },
              {
                "type": "text",
                "text": ", committed repo policy: modes, protected branches, changelog sections, release hooks"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "docs/plans/"
              },
              {
                "type": "text",
                "text": ", the preserved plans"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "No "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " means off: every hook exits immediately in an unconfigured repository."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "commit-conventions",
      "inlines": [
        {
          "type": "text",
          "text": "Commit conventions"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Work commits follow Conventional Commits: "
        },
        {
          "type": "code",
          "text": "type(scope): subject"
        },
        {
          "type": "text",
          "text": ", with "
        },
        {
          "type": "code",
          "text": "!"
        },
        {
          "type": "text",
          "text": " or a "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE:"
        },
        {
          "type": "text",
          "text": " footer marking a breaking change. The type table lives in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": " under "
        },
        {
          "type": "code",
          "text": "changelog.types"
        },
        {
          "type": "text",
          "text": "; "
        },
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " writes the default set, listed under "
        },
        {
          "type": "code",
          "text": "pk help changelog"
        },
        {
          "type": "text",
          "text": ", and whatever the file says is what "
        },
        {
          "type": "code",
          "text": "pk changelog"
        },
        {
          "type": "text",
          "text": " reads on release day, so the convention is what turns daily work into the changelog. "
        },
        {
          "type": "code",
          "text": "pk changelog --dry-run"
        },
        {
          "type": "text",
          "text": " previews how the current commits will land."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "One rule stands over the table: never add a breaking marker ("
        },
        {
          "type": "code",
          "text": "!"
        },
        {
          "type": "text",
          "text": " or a "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE:"
        },
        {
          "type": "text",
          "text": " footer) on your own judgment. Markers drive the next major version and are the developer's claim to make; write one only on explicit user direction. Guard asks before a marked commit is created."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "commands",
      "inlines": [
        {
          "type": "text",
          "text": "Commands"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Run "
        },
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " for the topic index. Each command's page is also a /plankit: shortcut in Claude Code, so one name means the same thing in the typeahead, the terminal, and this repository."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "migrating-from-pre-plugin-plankit-v0-x",
      "inlines": [
        {
          "type": "text",
          "text": "Migrating from pre-plugin plankit (v0.x)"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The plugin replaces everything "
        },
        {
          "type": "code",
          "text": "pk setup"
        },
        {
          "type": "text",
          "text": " used to copy into a repository. In a repository configured by a v0.x release:"
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Remove the plankit hook entries (guard, protect, preserve, and the install-pk SessionStart entry) from "
              },
              {
                "type": "code",
                "text": ".claude/settings.json"
              },
              {
                "type": "text",
                "text": ". The plugin wires the same hooks itself, and leftover entries fire everything twice."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Delete "
              },
              {
                "type": "code",
                "text": ".claude/install-pk.sh"
              },
              {
                "type": "text",
                "text": " and the copied "
              },
              {
                "type": "code",
                "text": ".claude/skills/"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": ".claude/rules/plankit/"
              },
              {
                "type": "text",
                "text": " files. The plugin ships current versions of the skills; the rules are retired."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Keep "
              },
              {
                "type": "code",
                "text": ".pk.json"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": "docs/plans/"
              },
              {
                "type": "text",
                "text": " exactly as they are. The config schema is unchanged and the plans remain the immutable record."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Nothing else changes: the guard, protect, and preserve behavior is unchanged, now arriving with the plugin instead of per-repository copies."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "windows-without-git-bash",
      "inlines": [
        {
          "type": "text",
          "text": "Windows without Git Bash"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "When Git for Windows is absent, Claude Code's shell tool is PowerShell, and the plugin's "
        },
        {
          "type": "code",
          "text": "bin/"
        },
        {
          "type": "text",
          "text": " directory is not on that shell's PATH. Invoke pk by its full path instead:"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\u0026 \"${CLAUDE_PLUGIN_ROOT}\\bin\\pk.cmd\" status\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Claude Code substitutes "
        },
        {
          "type": "code",
          "text": "${CLAUDE_PLUGIN_ROOT}"
        },
        {
          "type": "text",
          "text": " when it loads this page, so inside a session the line above already carries the real install location. In the terminal, "
        },
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " shows the placeholder verbatim."
        }
      ]
    }
  ]
}
