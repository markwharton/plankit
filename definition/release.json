        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "rejects": {
        "reason": "the directory is not in a git repository; HEAD is detached; .pk.json is missing or does not load; the checked-out branch is the release branch; HEAD has no Release-Tag trailer, or its value is not a semver tag; the working tree has uncommitted changes; origin does not have the working branch; origin does not answer; the working branch is behind origin's copy of it; the release branch is neither local nor on origin; origin's release branch is not an ancestor of HEAD; the latest semver tag is not in HEAD's history",
        "to": "parent",
        "source": { "file": "internal/release/release.go", "function": "run" } }
    },
    { "name": "merge",
      "source": { "file": "internal/release/release.go", "function": "run" },
      "reads": [
        { "place": "working branch",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "release branch",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "remote-tracking branches",
          "source": { "file": "internal/git/git.go", "function": "IsAncestor" } }
      ],
      "writes": [
        { "place": "working tree", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "release branch", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "rejects": {
