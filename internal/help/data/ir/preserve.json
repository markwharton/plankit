{
  "schema": 1,
  "meta": {
    "name": "preserve",
    "description": "Preserve the approved plan into docs/plans - modes, the pending pointer, and /plankit:preserve"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "pk preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Preserve copies an approved Claude Code plan, byte for byte, into "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " under a dated, sequenced, slugged filename and commits it with a "
        },
        {
          "type": "code",
          "text": "plan:"
        },
        {
          "type": "text",
          "text": " message."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "modes",
      "inlines": [
        {
          "type": "text",
          "text": "Modes"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The hook fires when a plan is approved (ExitPlanMode) and follows "
        },
        {
          "type": "code",
          "text": "preserve.mode"
        },
        {
          "type": "text",
          "text": " in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "auto"
              },
              {
                "type": "text",
                "text": ": preserve and commit at once"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": " (default): record the approved plan in a pending pointer and say so; nothing is committed until you ask"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": ": do nothing"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "completing-a-manual-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "Completing a manual preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Type "
        },
        {
          "type": "code",
          "text": "/plankit:preserve"
        },
        {
          "type": "text",
          "text": ", or run "
        },
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " in the repository. The explicit invocation consumes the pending pointer and commits, whatever the mode. "
        },
        {
          "type": "code",
          "text": "--push"
        },
        {
          "type": "text",
          "text": " also pushes the commit. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews the filename and commit message."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Limit: identical plan bytes are never preserved twice; a duplicate reports the existing file. Limit: a plan shorter than "
        },
        {
          "type": "code",
          "text": "minPlanSize"
        },
        {
          "type": "text",
          "text": " bytes is ignored ("
        },
        {
          "type": "code",
          "text": "grep minPlanSize internal/preserve/preserve.go"
        },
        {
          "type": "text",
          "text": ")."
        }
      ]
    }
  ]
}
