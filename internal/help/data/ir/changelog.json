{
  "schema": 1,
  "meta": {
    "name": "changelog",
    "description": "Generate CHANGELOG.md from conventional commits and stage a release with the Release-Tag trailer"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-changelog",
      "inlines": [
        {
          "type": "text",
          "text": "pk changelog"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Reads the conventional commits since the last version tag, infers the next version, writes the section into "
        },
        {
          "type": "code",
          "text": "CHANGELOG.md"
        },
        {
          "type": "text",
          "text": ", and commits with a "
        },
        {
          "type": "code",
          "text": "Release-Tag"
        },
        {
          "type": "text",
          "text": " trailer. No git tag is created; "
        },
        {
          "type": "code",
          "text": "pk release"
        },
        {
          "type": "text",
          "text": " creates it, so the release stays a two-step: generate and review, then tag and push."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "version-inference",
      "inlines": [
        {
          "type": "text",
          "text": "Version inference"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "A breaking change ("
        },
        {
          "type": "code",
          "text": "type!:"
        },
        {
          "type": "text",
          "text": " or a "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE:"
        },
        {
          "type": "text",
          "text": " footer) bumps major, "
        },
        {
          "type": "code",
          "text": "feat"
        },
        {
          "type": "text",
          "text": " bumps minor, anything else bumps patch. "
        },
        {
          "type": "code",
          "text": "--bump major|minor|patch"
        },
        {
          "type": "text",
          "text": " overrides. Types map to sections via "
        },
        {
          "type": "code",
          "text": "changelog.types"
        },
        {
          "type": "text",
          "text": " in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": "; hidden types are tracked but never listed. The default table "
        },
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " writes:"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "feat       Added\nfix        Fixed\ndeprecate  Deprecated\nrevert     Removed\nsecurity   Security\nrefactor   Changed\nperf       Changed\ndocs       Documentation\nchore      Maintenance\ntest       Maintenance\nbuild      Maintenance\nci         Maintenance\nstyle      Maintenance\nplan       (hidden: written by pk preserve, never listed)\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Edit "
        },
        {
          "type": "code",
          "text": "changelog.types"
        },
        {
          "type": "text",
          "text": " to rename sections, add types, or hide more. An empty table means the default table."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk changelog --dry-run\npk changelog\npk changelog --exclude abc1234,def5678\npk changelog --undo\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " prints the section to stdout and runs on a dirty tree. "
        },
        {
          "type": "code",
          "text": "--exclude"
        },
        {
          "type": "text",
          "text": " drops commits by short hash before bump inference. "
        },
        {
          "type": "code",
          "text": "--undo"
        },
        {
          "type": "text",
          "text": " unwinds an unpushed release commit, restoring "
        },
        {
          "type": "code",
          "text": "CHANGELOG.md"
        },
        {
          "type": "text",
          "text": " and version files."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "changelog.versionFiles"
        },
        {
          "type": "text",
          "text": " names JSON files whose root "
        },
        {
          "type": "code",
          "text": "version"
        },
        {
          "type": "text",
          "text": " field is spliced in place, formatting preserved. "
        },
        {
          "type": "code",
          "text": "postVersion"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "code",
          "text": "preCommit"
        },
        {
          "type": "text",
          "text": " hooks run with "
        },
        {
          "type": "code",
          "text": "$VERSION"
        },
        {
          "type": "text",
          "text": " (no v prefix)."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Run it from the working branch. A protected branch is refused."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --bump \u003cvalue\u003e\n        Override the version bump: major, minor, or patch\n  --dry-run\n        Print the section to stdout without writing or committing\n  --exclude \u003cvalue\u003e\n        Comma-separated commit SHAs to drop from the section\n  --undo\n        Unwind the last pk changelog commit (must be unpushed)\n"
    },
    {
      "type": "heading",
      "level": 2,
      "id": "settings",
      "inlines": [
        {
          "type": "text",
          "text": "Settings"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The "
        },
        {
          "type": "code",
          "text": "changelog"
        },
        {
          "type": "text",
          "text": " section of "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\"changelog\": {\n  \"hooks\": {\n    \"postVersion\": \"\u003ccommand\u003e\",\n    \"preCommit\": \"\u003ccommand\u003e\"\n  },\n  \"showScope\": true | false,\n  \"types\": [{ \"hidden\": true | false, \"section\": \"\u003csection\u003e\", \"type\": \"\u003ctype\u003e\" }, ...],\n  \"versionFiles\": [{ \"path\": \"\u003cpath\u003e\", \"type\": \"json\" }, ...]\n}\n"
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "changelog.hooks.postVersion"
              },
              {
                "type": "text",
                "text": ": a shell command; default none. Runs after the version files are stamped and before CHANGELOG.md is written, with "
              },
              {
                "type": "code",
                "text": "$VERSION"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "changelog.hooks.preCommit"
              },
              {
                "type": "text",
                "text": ": a shell command; default none. Runs before the release commit, with "
              },
              {
                "type": "code",
                "text": "$VERSION"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "changelog.showScope"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "true"
              },
              {
                "type": "text",
                "text": " or "
              },
              {
                "type": "code",
                "text": "false"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "false"
              },
              {
                "type": "text",
                "text": ". Includes each commit's scope in its changelog entry."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "changelog.types"
              },
              {
                "type": "text",
                "text": ": a list of "
              },
              {
                "type": "code",
                "text": "{\"type\", \"section\", \"hidden\"}"
              },
              {
                "type": "text",
                "text": " rows; default the table under "
              },
              {
                "type": "code",
                "text": "pk help changelog"
              },
              {
                "type": "text",
                "text": ". Maps commit types to changelog sections; a hidden type is tracked and never listed; an empty list means the default table."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "changelog.versionFiles"
              },
              {
                "type": "text",
                "text": ": a list of "
              },
              {
                "type": "code",
                "text": "{\"path\", \"type\"}"
              },
              {
                "type": "text",
                "text": " rows; default none. JSON files whose root "
              },
              {
                "type": "code",
                "text": "version"
              },
              {
                "type": "text",
                "text": " field is stamped in place at release."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: "
        },
        {
          "type": "code",
          "text": "pk"
        },
        {
          "type": "text",
          "text": " commands exit 2, and each hook reports the message and takes no action until it is fixed. An absent key means its default. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads the file back and reports the first problem."
        }
      ]
    }
  ]
}
