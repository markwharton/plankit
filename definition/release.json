        { "place": "settings",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "release commit",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "writes": [
        { "place": "message", "mode": "write",
          "source": { "file": "internal/hookio/hookio.go", "function": "RunHook" } }
      ],
      "rejects": {
        "reason": "the release.hooks.preRelease command ends with a failure",
        "to": "parent",
        "source": { "file": "internal/hookio/hookio.go", "function": "RunHook" } }
    },
    { "name": "tag",
      "source": { "file": "internal/release/release.go", "function": "run" },
      "reads": [
        { "place": "release commit",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "tags",
          "source": { "file": "internal/changelog/trailer.go", "function": "ReleaseTagState" } }
      ],
      "writes": [
        { "place": "tags", "mode": "create", "key": "content", "records": "one",
          "source": { "file": "internal/git/git.go", "function": "CreateTag" },
          "before": [
            { "check": "exists", "then": "refuse",
              "source": { "file": "internal/changelog/trailer.go", "function": "ReleaseTagState" } }
          ] },
        { "place": "message", "mode": "write",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "rejects": {
        "reason": "a local tag of the trailer's name already exists, on HEAD or on another commit; or git fails to create the tag",
