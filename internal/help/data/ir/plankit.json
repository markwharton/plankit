{
  "schema": 1,
  "meta": {
    "name": "plankit",
    "description": "Plan-driven development for Claude Code - the model, the modes, and the per-repo footprint"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "plankit",
      "inlines": [
        {
          "type": "text",
          "text": "plankit"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "plankit preserves approved Claude Code plans, guards protected branches, and derives releases from commit messages. It ships as a Claude Code plugin. These skills are the documentation; "
        },
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " renders the same pages in a terminal."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "model",
      "inlines": [
        {
          "type": "text",
          "text": "Model"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Claude plans the work. On approval, the preserve hook copies the plan, byte for byte, into "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " under a dated, sequenced filename. The protect hook denies edits under "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": ". The guard hook denies or questions git mutations on protected branches."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "per-repo-footprint",
      "inlines": [
        {
          "type": "text",
          "text": "Per-repo footprint"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "A configured repository carries "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ", the committed policy: modes, protected branches, changelog sections, release hooks. "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " appears when the first plan is preserved. Without "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ", every hook exits without acting."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "commit-conventions",
      "inlines": [
        {
          "type": "text",
          "text": "Commit conventions"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Work commits follow Conventional Commits: "
        },
        {
          "type": "code",
          "text": "type(scope): subject"
        },
        {
          "type": "text",
          "text": ". "
        },
        {
          "type": "code",
          "text": "!"
        },
        {
          "type": "text",
          "text": " after the type or a "
        },
        {
          "type": "code",
          "text": "BREAKING CHANGE:"
        },
        {
          "type": "text",
          "text": " footer marks a breaking change. The type table is "
        },
        {
          "type": "code",
          "text": "changelog.types"
        },
        {
          "type": "text",
          "text": " in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": "; "
        },
        {
          "type": "code",
          "text": "pk init"
        },
        {
          "type": "text",
          "text": " writes the default table, listed under "
        },
        {
          "type": "code",
          "text": "pk help changelog"
        },
        {
          "type": "text",
          "text": ". "
        },
        {
          "type": "code",
          "text": "pk changelog --dry-run"
        },
        {
          "type": "text",
          "text": " previews how the current commits will land. Never add a breaking marker on your own judgment; see "
        },
        {
          "type": "code",
          "text": "pk help guard"
        },
        {
          "type": "text",
          "text": ", Breaking markers."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "commands",
      "inlines": [
        {
          "type": "text",
          "text": "Commands"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " prints the topic index. Each command's page is also a "
        },
        {
          "type": "code",
          "text": "/plankit:"
        },
        {
          "type": "text",
          "text": " shortcut in Claude Code."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "migrating-from-pre-plugin-plankit-v0-x",
      "inlines": [
        {
          "type": "text",
          "text": "Migrating from pre-plugin plankit (v0.x)"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The plugin replaces the files "
        },
        {
          "type": "code",
          "text": "pk setup"
        },
        {
          "type": "text",
          "text": " copied into a repository. In a repository configured by a v0.x release:"
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Remove the plankit hook entries (guard, protect, preserve, and the install-pk SessionStart entry) from "
              },
              {
                "type": "code",
                "text": ".claude/settings.json"
              },
              {
                "type": "text",
                "text": ". Reason: the plugin wires the same hooks, and leftover entries fire twice."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Delete "
              },
              {
                "type": "code",
                "text": ".claude/install-pk.sh"
              },
              {
                "type": "text",
                "text": ", the copied "
              },
              {
                "type": "code",
                "text": ".claude/skills/"
              },
              {
                "type": "text",
                "text": ", and "
              },
              {
                "type": "code",
                "text": ".claude/rules/plankit/"
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "text",
                "text": "Keep "
              },
              {
                "type": "code",
                "text": ".pk.json"
              },
              {
                "type": "text",
                "text": " and "
              },
              {
                "type": "code",
                "text": "docs/plans/"
              },
              {
                "type": "text",
                "text": ". The config schema is unchanged."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "windows-without-git-bash",
      "inlines": [
        {
          "type": "text",
          "text": "Windows without Git Bash"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "When Git for Windows is absent, Claude Code's shell tool is PowerShell, and the plugin's "
        },
        {
          "type": "code",
          "text": "bin/"
        },
        {
          "type": "text",
          "text": " directory is not on its PATH. Invoke pk by its full path:"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\u0026 \"${CLAUDE_PLUGIN_ROOT}\\bin\\pk.cmd\" status\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Claude Code substitutes "
        },
        {
          "type": "code",
          "text": "${CLAUDE_PLUGIN_ROOT}"
        },
        {
          "type": "text",
          "text": " when it loads this page. In a terminal, "
        },
        {
          "type": "code",
          "text": "pk help"
        },
        {
          "type": "text",
          "text": " shows the placeholder verbatim."
        }
      ]
    }
  ]
}
