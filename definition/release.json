        "source": { "file": "internal/release/release.go", "function": "run" } }
    },
    { "name": "prePush hook",
      "source": { "file": "internal/hookio/hookio.go", "function": "RunHook" },
      "reads": [
        { "place": "settings",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "release commit",
          "source": { "file": "internal/release/release.go", "function": "run" } }
      ],
      "writes": [
        { "place": "message", "mode": "write",
          "source": { "file": "internal/hookio/hookio.go", "function": "RunHook" } }
      ],
      "rejects": {
        "reason": "the release.hooks.prePush command ends with a failure",
        "to": "parent",
        "source": { "file": "internal/hookio/hookio.go", "function": "RunHook" } }
    },
    { "name": "push",
      "source": { "file": "internal/release/release.go", "function": "run" },
      "reads": [
        { "place": "release branch",
          "source": { "file": "internal/release/release.go", "function": "run" } },
        { "place": "tags",
          "source": { "file": "internal/release/release.go", "function": "run" } }
