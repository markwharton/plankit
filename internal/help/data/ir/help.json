{
  "schema": 1,
  "meta": {
    "name": "help",
    "description": "Show documentation for pk and its commands"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-help",
      "inlines": [
        {
          "type": "text",
          "text": "pk help"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Renders plankit's documentation in a terminal. The same pages ship as skills in the plugin, compiled from one source."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "usage",
      "inlines": [
        {
          "type": "text",
          "text": "Usage"
        }
      ]
    },
    {
      "type": "codeblock",
      "lang": "bash",
      "text": "pk help\npk help \u003ctopic\u003e\n"
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Without a topic, prints the index. A terminal gets styled, wrapped text. A pipe gets the raw authored bytes. "
        },
        {
          "type": "code",
          "text": "--plain"
        },
        {
          "type": "text",
          "text": " forces undecorated output. "
        },
        {
          "type": "code",
          "text": "NO_COLOR"
        },
        {
          "type": "text",
          "text": " is respected."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "universal-flags",
      "inlines": [
        {
          "type": "text",
          "text": "Universal flags"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Every command accepts these:"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --project-dir \u003cvalue\u003e\n        Project directory (default: PK_PROJECT_DIR, else the current directory)\n  --plain\n        Undecorated output: no color, no wrapping\n  --quiet\n        Suppress notes and hints (errors still print)\n"
    }
  ]
}
