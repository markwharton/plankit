{
  "schema": 1,
  "meta": {
    "name": "preserve",
    "description": "Preserve the approved plan into docs/plans - modes, the pending pointer, and /plankit:preserve"
  },
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "id": "pk-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "pk preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " copies an approved Claude Code plan, byte for byte, into "
        },
        {
          "type": "code",
          "text": "docs/plans/"
        },
        {
          "type": "text",
          "text": " under a dated, sequenced, slugged filename and commits it with a "
        },
        {
          "type": "code",
          "text": "plan:"
        },
        {
          "type": "text",
          "text": " message."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "modes",
      "inlines": [
        {
          "type": "text",
          "text": "Modes"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The hook fires when a plan is approved (ExitPlanMode) and follows "
        },
        {
          "type": "code",
          "text": "preserve.mode"
        },
        {
          "type": "text",
          "text": " in "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "auto"
              },
              {
                "type": "text",
                "text": ": preserve and commit at once"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": " (default): record the approved plan in a pending pointer and say so; nothing is committed until you ask"
              }
            ]
          }
        ],
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": ": do nothing"
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "completing-a-manual-preserve",
      "inlines": [
        {
          "type": "text",
          "text": "Completing a manual preserve"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Type "
        },
        {
          "type": "code",
          "text": "/plankit:preserve"
        },
        {
          "type": "text",
          "text": ", or run "
        },
        {
          "type": "code",
          "text": "pk preserve"
        },
        {
          "type": "text",
          "text": " in the repository. The explicit invocation consumes the pending pointer and commits, whatever the mode. "
        },
        {
          "type": "code",
          "text": "--push"
        },
        {
          "type": "text",
          "text": " also pushes the commit. "
        },
        {
          "type": "code",
          "text": "--dry-run"
        },
        {
          "type": "text",
          "text": " previews the filename and commit message."
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "Identical plan bytes are never preserved twice; a duplicate reports the existing file. A plan shorter than "
        },
        {
          "type": "code",
          "text": "minPlanSize"
        },
        {
          "type": "text",
          "text": " bytes is ignored ("
        },
        {
          "type": "code",
          "text": "grep minPlanSize internal/preserve/preserve.go"
        },
        {
          "type": "text",
          "text": ")."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "flags",
      "inlines": [
        {
          "type": "text",
          "text": "Flags"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "  --push\n        Push to origin after committing\n  --dry-run\n        Preview without writing or committing\n"
    },
    {
      "type": "heading",
      "level": 2,
      "id": "settings",
      "inlines": [
        {
          "type": "text",
          "text": "Settings"
        }
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "The "
        },
        {
          "type": "code",
          "text": "preserve"
        },
        {
          "type": "text",
          "text": " section of "
        },
        {
          "type": "code",
          "text": ".pk.json"
        },
        {
          "type": "text",
          "text": ":"
        }
      ]
    },
    {
      "type": "codeblock",
      "text": "\"preserve\": {\n  \"mode\": \"auto\" | \"manual\" | \"off\"\n}\n"
    },
    {
      "type": "list",
      "items": [
        [
          {
            "type": "para",
            "inlines": [
              {
                "type": "code",
                "text": "preserve.mode"
              },
              {
                "type": "text",
                "text": ": "
              },
              {
                "type": "code",
                "text": "auto"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": ", or "
              },
              {
                "type": "code",
                "text": "off"
              },
              {
                "type": "text",
                "text": "; default "
              },
              {
                "type": "code",
                "text": "manual"
              },
              {
                "type": "text",
                "text": ". An approved plan is committed at once, recorded for "
              },
              {
                "type": "code",
                "text": "/plankit:preserve"
              },
              {
                "type": "text",
                "text": " to commit, or ignored."
              }
            ]
          }
        ]
      ]
    },
    {
      "type": "para",
      "inlines": [
        {
          "type": "text",
          "text": "An unknown key or a value outside these fails the whole file when it loads, with a message naming the key: "
        },
        {
          "type": "code",
          "text": "pk"
        },
        {
          "type": "text",
          "text": " commands exit 2, and each hook reports the message and takes no action until it is fixed. An absent key means its default. "
        },
        {
          "type": "code",
          "text": "pk status"
        },
        {
          "type": "text",
          "text": " reads the file back and reports the first problem."
        }
      ]
    }
  ]
}
