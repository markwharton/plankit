#!/bin/sh
# Dispatch to the platform binary sitting next to this shim. The binaries
# are release assets (pk-<os>-<arch>), not committed files; `make bin-local`
# builds the current platform's one for development. Without one, the pk
# on PATH runs instead, told where this plugin is through PK_PLUGIN_ROOT.
set -e
dir=$(dirname "$0")
os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) echo "pk: unsupported platform: $os" >&2; exit 3 ;;
esac
case "$arch" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo "pk: unsupported architecture: $arch" >&2; exit 3 ;;
esac
bin="$dir/pk-$os-$arch"
if [ "$os" = windows ]; then bin="$bin.exe"; fi
if [ -x "$bin" ]; then
  exec "$bin" "$@"
fi
# No binary beside the shim: the plugin arrived without its release
# assets. Walk PATH for another pk, skipping this shim's own directory,
# which Claude Code puts on the PATH while the plugin is enabled.
here=$(cd "$dir" && pwd -P)
root=$(cd "$dir/.." && pwd -P)
oldifs=$IFS
IFS=:
for p in $PATH; do
  [ -n "$p" ] || p=.
  [ -f "$p/pk" ] && [ -x "$p/pk" ] || continue
  [ "$(cd "$p" 2>/dev/null && pwd -P)" = "$here" ] && continue
  IFS=$oldifs
  PK_PLUGIN_ROOT="$root" exec "$p/pk" "$@"
done
IFS=$oldifs
echo "pk: $bin not found; run 'make bin-local' in the plankit repo, reinstall the plugin, or install pk (go install github.com/markwharton/plankit/cmd/pk@latest)" >&2
exit 3
